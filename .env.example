# SMART SCHOOL BUS — SOZLAMALAR
SECRET_KEY=smart-school-bus-secure-jwt-key-2026-very-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite ma'lumotlar bazasi fayli
DATABASE_PATH=school_bus.db

# Telegram Bot Sozlamalari (Ixtiyoriy, BotFather orqali olingan token)
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_CHAT_ID=

# Bekat geofence radiusi (metrda)
DEFAULT_GEOFENCE_RADIUS=100

# GPS aloqasi uzilish chegarasi (soniyada)
GPS_STALE_THRESHOLD_SECONDS=120
